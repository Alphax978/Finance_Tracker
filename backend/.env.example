MONGO_URI=
PORT=6100
RESEND_API_KEY=
# Optional — defaults to Resend's sandbox address (onboarding@resend.dev), which works
# without any setup but is rate-limited and only sends to your own verified email.
# Once you verify a domain in the Resend dashboard, set this to an address on that domain
# (e.g. notifications@yourdomain.com) to send to any recipient. Just the bare address —
# the "Finance Tracker" display name is added automatically.
RESEND_FROM_EMAIL=
# 64-char hex string (32 random bytes) used to AES-256-GCM encrypt salary data at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SALARY_ENCRYPTION_KEY=

# Used to build links back to the app (emails, Stripe checkout redirects).
# Set this to your real domain once deployed.
FRONTEND_URL=http://localhost:5173

# --- Telegram (Chat Automation) ---------------------------------------
# Message @BotFather on Telegram -> /newbot -> paste the token it gives you.
TELEGRAM_BOT_TOKEN=
# The @username BotFather assigned your bot (no @), shown in the app's connect instructions.
TELEGRAM_BOT_USERNAME=

# --- Stripe (Automation subscription, $2/month) ------------------------
# Stripe Dashboard -> Developers -> API keys (use the test-mode key first).
STRIPE_SECRET_KEY=
# Stripe Dashboard -> Product catalog -> create a $2/month recurring Price -> copy its ID.
STRIPE_PRICE_ID=
# Stripe Dashboard -> Developers -> Webhooks -> add endpoint {backend}/api/subscription/webhook -> copy the signing secret.
STRIPE_WEBHOOK_SECRET=

# --- WhatsApp Cloud API (inert until Meta Business verification is done) ---
# Any string you choose — enter the same value when registering the webhook in Meta's app dashboard.
WHATSAPP_VERIFY_TOKEN=
# Meta App Dashboard -> WhatsApp -> API Setup -> temporary or permanent access token.
WHATSAPP_ACCESS_TOKEN=

# --- Messenger Platform (inert until Meta app review is done) -----------
# Any string you choose — enter the same value when registering the webhook in Meta's app dashboard.
MESSENGER_VERIFY_TOKEN=
# Meta App Dashboard -> Messenger -> Settings -> Page access token.
MESSENGER_PAGE_ACCESS_TOKEN=

# --- Vercel Cron (monthly digest) ---------------------------------------
# Vercel automatically sends this as "Authorization: Bearer <value>" on
# cron-triggered requests — set the same value in the Vercel project's
# environment variables so /api/monthlydigest/cron can verify the caller.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
