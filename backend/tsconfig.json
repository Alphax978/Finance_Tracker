{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "moduleResolution": "node16",
    "outDir": "./build",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "node16",
    "target": "esnext",
    "types": [],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
  // api/index.ts is bundled and type-stripped by Vercel's own build
  // pipeline, not by this project's tsc — it lives outside rootDir on
  // purpose and isn't part of the local build/dev program. build/ has to
  // be excluded too, otherwise a second build without deleting the first
  // picks up its own prior .d.ts output as input and collides with itself.
  "exclude": ["api", "build"]
}
